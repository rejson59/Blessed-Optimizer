<Window x:Class="BlessedOptimizer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blessed Optimizer — instalator"
        Width="700" Height="600" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="62" Height="62" CornerRadius="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
        <Image x:Name="LogoImage" Source="pack://application:,,,/Assets/blessed-optimizer-logo-no-background.png" Stretch="Uniform" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
        <TextBlock Text="Blessed Optimizer" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="Instalator i aplikacja · wersja 1.0.2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
      </StackPanel>
      <Border Grid.Column="2" VerticalAlignment="Top" Padding="10,6" CornerRadius="999" Background="#203D5B" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <TextBlock Text="BEZ UPRAWNIEŃ ADMINA" Foreground="{DynamicResource GoldBrush}" FontSize="9" FontWeight="Bold" />
      </Border>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="Cześć! Jestem Blessed." FontSize="27" FontWeight="SemiBold" />
      <TextBlock Text="Zainstaluję aplikację w Twoim profilu Windows. Przy okazji odczytam podstawowe parametry komputera, żeby pokazać Ci kilka ciekawostek." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" LineHeight="21" Margin="0,8,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="2">
      <Border Padding="17" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Border x:Name="ScanBadge" DockPanel.Dock="Right" Padding="9,5" CornerRadius="999" Background="#203D5B">
              <TextBlock x:Name="ScanBadgeText" Text="TYLKO LOKALNIE" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" />
            </Border>
            <TextBlock Text="Podczas instalacji sprawdzę" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="Procesor · pamięć RAM · karta graficzna · wolne miejsce · sieć" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock x:Name="DetectedSummary" Text="Nie uruchamiam testu wydajności ani benchmarku. Odczyt zostaje na tym urządzeniu." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Margin="0,13,0,0" Padding="16" CornerRadius="16" Background="#142D48" BorderBrush="#385572" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="CIEKAWOSTKA OD BLESSED" Foreground="{DynamicResource GoldBrush}" FontSize="9" FontWeight="Bold" />
          <TextBlock x:Name="FactText" Text="Czy Twój PC odpali 300 kalkulatorów bez zacięcia? Nie będę zgadywać — najpierw sprawdzę jego podzespoły." TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" LineHeight="21" Margin="0,7,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Margin="0,16,0,0">
        <DockPanel>
          <TextBlock x:Name="ProgressLabel" Text="Gotów, kiedy Ty jesteś." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
          <TextBlock x:Name="ProgressValue" Text="0%" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" />
        </DockPanel>
        <Grid Height="31" Margin="0,3,0,0">
          <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Height="7" Value="0" VerticalAlignment="Bottom" Background="#243B55" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
          <Image x:Name="ProgressDove" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Source="pack://application:,,,/Assets/blessed-optimizer-logo-no-background.png" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform><RotateTransform Angle="0" /></Image.RenderTransform>
          </Image>
        </Grid>
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,20,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="False">
        <CheckBox x:Name="DesktopShortcutCheck" Content="Dodaj skrót na pulpicie" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" IsChecked="False" />
        <TextBlock Text="Instalacja tylko dla Ciebie" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center" />
      </DockPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button x:Name="ExistingButton" Content="Otwórz zainstalowany program" Style="{StaticResource SecondaryButton}" Click="Existing_Click" Visibility="Collapsed" Margin="0,0,9,0" />
        <Button x:Name="PortableButton" Content="Uruchom bez instalacji" Style="{StaticResource SecondaryButton}" Click="Portable_Click" Margin="0,0,9,0" />
        <Button x:Name="InstallButton" Content="Zainstaluj Blessed" Style="{StaticResource PrimaryButton}" Click="Install_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
