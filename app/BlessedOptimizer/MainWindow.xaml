<Window x:Class="BlessedOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Blessed Optimizer" Width="1160" Height="790" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="WindowFrame" Margin="6" CornerRadius="18" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" CornerRadius="17,17,0,0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5">
            <Image x:Name="LogoImage" Source="pack://application:,,,/Assets/blessed-optimizer-logo-no-background.png" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
            <TextBlock Text="Blessed Optimizer" FontSize="17" FontWeight="Bold" />
            <TextBlock x:Name="HeaderSummary" Text="Twój lokalny panel diagnostyczny Windows" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" Width="230">
            <TextBlock Text="AKTUALIZACJE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" />
            <TextBlock x:Name="UpdateStatusText" Text="Sprawdzę przy uruchomieniu" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Right" MaxWidth="230" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button x:Name="CheckUpdateButton" Grid.Column="3" Content="Sprawdź" Style="{StaticResource SecondaryButton}" Click="CheckUpdate_Click" Padding="12,8" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Border Grid.Column="4" Margin="0,0,10,0" Padding="9,6" CornerRadius="999" Background="#203D5B" VerticalAlignment="Center">
            <TextBlock x:Name="VersionText" Text="v1.0.2" Foreground="{DynamicResource GoldBrush}" FontSize="10" FontWeight="Bold" />
          </Border>
          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="−" Style="{StaticResource WindowControlButton}" ToolTip="Minimalizuj" Click="MinimizeWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="WindowMaximizeButton" Style="{StaticResource WindowControlButton}" ToolTip="Maksymalizuj" Click="ToggleWindowState_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <TextBlock x:Name="WindowMaximizeGlyph" Text="□" FontSize="13" VerticalAlignment="Center" />
            </Button>
            <Button Content="×" Tag="Close" Style="{StaticResource WindowControlButton}" ToolTip="Zamknij" Click="CloseWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Margin="15,10,15,0" Padding="10,7" CornerRadius="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="GamingNavButton" Tag="active" Style="{StaticResource NavigationButton}" Click="Navigate_Click" ToolTip="Monitorowanie odczytów CPU i RAM podczas gry">
              <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="Strefa gracza" /></StackPanel>
            </Button>
            <Button x:Name="ConnectionsNavButton" Style="{StaticResource NavigationButton}" Click="Navigate_Click" ToolTip="Lokalny podgląd adapterów i test ping po kliknięciu">
              <StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="Połączenia" /></StackPanel>
            </Button>
            <Button x:Name="ProposalsNavButton" Style="{StaticResource NavigationButton}" Click="Navigate_Click" ToolTip="Ręczne propozycje wymagające Twojej decyzji">
              <StackPanel Orientation="Horizontal"><TextBlock Text="✧" Foreground="{DynamicResource GoldBrush}" Margin="0,0,7,0"/><TextBlock Text="Propozycje" /></StackPanel>
            </Button>
            <Button x:Name="PersonalizationNavButton" Style="{StaticResource NavigationButton}" Click="Navigate_Click" ToolTip="Zmień wygląd aplikacji; ustawienia Windows pozostają nietknięte">
              <StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="Personalizacja Windows" /></StackPanel>
            </Button>

            <Border Width="1" Height="28" Margin="4,0,13,0" Background="{DynamicResource BorderBrush}" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,9,0">
              <TextBlock Text="DODATKOWE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="7" FontWeight="Bold" />
              <TextBlock Text="NARZĘDZIA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="7" FontWeight="Bold" Margin="0,2,0,0" />
            </StackPanel>
            <Button x:Name="ProcessesNavButton" Style="{StaticResource NavigationToolButton}" Click="Navigate_Click" ToolTip="Szczegółowy, lokalny podgląd CPU i pamięci każdego procesu">
              <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/><TextBlock Text="Procesy" /></StackPanel>
            </Button>
            <Button x:Name="StartupNavButton" Style="{StaticResource NavigationToolButton}" Click="Navigate_Click" ToolTip="Autostart bieżącego użytkownika z kopią i przywracaniem">
              <StackPanel Orientation="Horizontal"><TextBlock Text="↻" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/><TextBlock Text="Autostart" /></StackPanel>
            </Button>
            <Button x:Name="PowerNavButton" Style="{StaticResource NavigationToolButton}" Click="Navigate_Click" ToolTip="Zaawansowane ustawienia planu zasilania AC i baterii">
              <StackPanel Orientation="Horizontal"><TextBlock Text="ϟ" Foreground="{DynamicResource GoldBrush}" Margin="0,0,6,0"/><TextBlock Text="Zasilanie" /></StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="2" Margin="15,13,15,9">
        <Border Padding="19,16,19,14" CornerRadius="18" Background="{DynamicResource WorkspaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="44">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceKicker" Text="TWÓJ PANEL · DANE NA ŻYWO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" />
                <TextBlock x:Name="WorkspaceTitle" Text="Strefa gracza" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Padding="10,7" CornerRadius="999" Background="{DynamicResource StatusBrush}" BorderBrush="#39816B" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="#89EAC0" VerticalAlignment="Center" Margin="0,0,7,0" />
                  <TextBlock x:Name="WorkspaceStatusText" Text="Blessed jest gotowy" Foreground="{DynamicResource StatusTextBrush}" FontSize="9" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,11" CornerRadius="16" Background="{DynamicResource GuideBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="15" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" VerticalAlignment="Center">
                  <Image Source="pack://application:,,,/Assets/blessed-optimizer-logo-no-background.png" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,12,0">
                  <TextBlock Text="BLESSED · TWÓJ POMOCNIK" Foreground="{DynamicResource GoldBrush}" FontSize="8" FontWeight="Bold" />
                  <TextBlock x:Name="BlessedMessage" Text="Poprowadzę Cię krok po kroku, zawsze za Twoją zgodą." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Padding="9,6" CornerRadius="999" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                  <TextBlock Text="TY DECYDUJESZ" Foreground="{DynamicResource AccentBrush}" FontSize="8" FontWeight="Bold" />
                </Border>
              </Grid>
            </Border>

            <DockPanel Grid.Row="2" LastChildFill="False" Margin="2,13,2,10" MinHeight="26">
              <TextBlock Text="WYBRANA KATEGORIA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock Text="›" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Margin="9,0" VerticalAlignment="Center" />
              <TextBlock x:Name="CrumbTitle" Text="STREFA GRACZA" Foreground="{DynamicResource AccentBrush}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
              <Border DockPanel.Dock="Right" Padding="8,4" CornerRadius="999" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="LOKALNIE · BEZ TELEMETRII" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="7" FontWeight="Bold" />
              </Border>
            </DockPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
              <StackPanel x:Name="PageHost" Margin="0,0,5,0" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <DockPanel Grid.Row="3" LastChildFill="False" Margin="10,0,10,0" MinHeight="25">
        <TextBlock Text="✦" Foreground="{DynamicResource GoldBrush}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
        <TextBlock x:Name="FooterStatusText" Text="Działa lokalnie · każda zmiana wymaga Twojej zgody" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
        <TextBlock x:Name="InstallModeText" Text="Instalacja dla bieżącego użytkownika" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
