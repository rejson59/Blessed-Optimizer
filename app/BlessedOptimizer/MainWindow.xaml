<Window x:Class="BlessedOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blessed Optimizer" Width="1120" Height="760" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="15,12" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="45" Height="45" CornerRadius="13" Background="{DynamicResource SurfaceRaisedBrush}" Padding="5">
          <Image x:Name="LogoImage" Source="pack://application:,,,/Assets/blessed-optimizer-logo-no-background.png" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="Blessed Optimizer" FontSize="18" FontWeight="Bold" />
          <TextBlock x:Name="HeaderSummary" Text="Przyjazny panel diagnostyczny Windows" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="AKTUALIZACJE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" />
            <TextBlock x:Name="UpdateStatusText" Text="Sprawdzę przy uruchomieniu" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Right" MaxWidth="250" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button x:Name="CheckUpdateButton" Content="Sprawdź" Style="{StaticResource SecondaryButton}" Click="CheckUpdate_Click" Padding="12,8" />
          <Border Margin="10,0,0,0" Padding="9,6" CornerRadius="999" Background="#203D5B">
            <TextBlock x:Name="VersionText" Text="v1.0.0" Foreground="{DynamicResource GoldBrush}" FontSize="10" FontWeight="Bold" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,14,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Padding="12" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="TWOJE OBSZARY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" Margin="8,6,8,10" />
            <Button x:Name="GamingNavButton" Tag="active" Style="{StaticResource NavigationButton}" Click="Navigate_Click" ToolTip="Monitorowanie odczytów CPU i RAM podczas gry">
              <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Strefa gracza" /></StackPanel>
            </Button>
            <Button x:Name="ConnectionsNavButton" Style="{StaticResource NavigationButton}" Click="Navigate_Click" ToolTip="Lokalny podgląd adapterów i test ping po kliknięciu">
              <StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Połączenia" /></StackPanel>
            </Button>
            <Button x:Name="ProposalsNavButton" Style="{StaticResource NavigationButton}" Click="Navigate_Click" ToolTip="Ręczne propozycje wymagające Twojej decyzji">
              <StackPanel Orientation="Horizontal"><TextBlock Text="✧" Foreground="{DynamicResource GoldBrush}" Margin="0,0,10,0"/><TextBlock Text="Propozycje" /></StackPanel>
            </Button>
            <Button x:Name="PersonalizationNavButton" Style="{StaticResource NavigationButton}" Click="Navigate_Click" ToolTip="Zmień wygląd aplikacji; ustawienia Windows pozostają nietknięte">
              <StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Personalizacja" /></StackPanel>
            </Button>
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Margin="2,16,2,2" Padding="12" CornerRadius="13" Background="{DynamicResource SurfaceRaisedBrush}">
            <StackPanel>
              <TextBlock Text="TWOJE DANE ZOSTAJĄ U CIEBIE" Foreground="{DynamicResource GoldBrush}" FontSize="8" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Text="Diagnostyka działa lokalnie. Do GitHub łączę się tylko, by sprawdzić aktualizacje." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
        <StackPanel x:Name="PageHost" Margin="0,0,5,0" />
      </ScrollViewer>
    </Grid>

    <DockPanel Grid.Row="2" LastChildFill="False" Margin="4,0,4,0">
      <TextBlock Text="✦" Foreground="{DynamicResource GoldBrush}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
      <TextBlock x:Name="FooterStatusText" Text="Tylko odczyt · Żadne procesy nie są zamykane" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
      <TextBlock x:Name="InstallModeText" Text="Instalacja dla bieżącego użytkownika" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" />
    </DockPanel>
  </Grid>
</Window>
